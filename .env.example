# ORBITALIS local configuration (SDD Appendix A).
# Copy to .env. Never commit .env.

# --- Runtime ---------------------------------------------------------------
ORB_ENV=dev
ORB_PORT=8080
ORB_DATA_DIR=./.data
ORB_CACHE_MAX_MB=400
ORB_OFFLINE=0
ORB_CORS_ORIGINS=http://localhost:3000
ORB_LOG_LEVEL=INFO

# --- IRSA gateway ----------------------------------------------------------
ORB_IRSA_CONCURRENCY=4
ORB_IRSA_TAP_TIMEOUT_S=60
ORB_IRSA_CUTOUT_TIMEOUT_S=30
ORB_BREAKER_THRESHOLD=5
ORB_BREAKER_COOLDOWN_S=30
ORB_TAP_TTL_S=21600

# --- Field pipeline --------------------------------------------------------
ORB_MAX_FRAMES=120
ORB_MAX_RADIUS_DEG=0.5
ORB_MAX_ACTIVE_FIELDS=3
ORB_GRACE_S=20
ORB_STRETCH_FIX_N=8

# --- Jobs and research -----------------------------------------------------
ORB_JOBS_MAX_RUNNING=1
ORB_JOBS_QUEUE_MAX=10
ORB_JOB_TIMEOUT_S=600
ORB_SEARCH_MAX_WORK=2e9
ORB_VALIDATION_MAX_INJECTIONS=200
ORB_MATCH_RADIUS_PX=2
ORB_STACK_POLICY=config/stack_policy.yaml
ORB_MODEL_PATH=models/candidate_cnn.onnx

# --- Assistant (optional; unset disables the feature) ----------------------
ORB_LLM_PROVIDER=
ORB_LLM_MODEL=
# Secret: never commit a real value.
ORB_LLM_API_KEY=
ORB_ASSISTANT_RPM=10
ORB_ASSISTANT_DAILY_CAP=
ORB_ASSISTANT_MAX_TOOL_ITERS=5
ORB_ASSISTANT_MAX_OUTPUT_TOKENS=800
